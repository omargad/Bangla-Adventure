# Copy to /opt/bangla-adventures/.env as the deployment user with mode 0600.
# PUBLIC_ORIGIN stays empty until Faysal confirms the real HTTPS domain.
PUBLIC_ORIGIN=
APP_PORT=3001
COMPOSE_PROJECT_NAME=bangla-adventures
# Optional runtime narration. The key normally arrives from the ELEVENLABS_API_KEY GitHub secret
# on each deploy, which writes it here; it can also be set here by hand. Never commit it.
# Leave unset to use bundled audio and any previously cached narration without new generation.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=
# ELEVENLABS_DAILY_CHARACTER_LIMIT=
# APP_IMAGE is maintained by deploy-remote.sh after deployment.
