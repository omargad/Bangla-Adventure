# Non-secret GitHub Actions variables for Faysal's VPS, supplied 2026-11-05.
# This is a settings template, not an instruction to enable deployment.
# DEPLOY_ENABLED must be a repository-level variable.
DEPLOY_ENABLED=false
# The server address and SSH account come from the server handover email. Set them
# only as the repository SECRETS DEPLOY_HOST and DEPLOY_USER, so GitHub masks them in
# run logs; do not write them here or as variables, as this repository is public.
# DEPLOY_HOST=
# DEPLOY_USER=
DEPLOY_PORT=22
DEPLOY_PATH=/opt/bangla-adventures
DEPLOY_DOCKER_HOST=unix:///run/user/1002/docker.sock
# Fixed true in the GitHub workflow; these values also apply to manual scripts.
DEPLOY_REQUIRE_ROOTLESS=true
DEPLOY_REQUIRE_PUBLIC_HEALTH=true
DEPLOY_HOST_FINGERPRINT=SHA256:79xe+ubCodL2ACAHPNloo7I/K6mvngU88vEiFoEeWL8
DEPLOY_KEY_FINGERPRINT=SHA256:y1+C6cvcfpJFmO8pfjyMSFERpd5BtcQyDf5SptZXVlQ
# Add only the verified server public-key line matching DEPLOY_HOST_FINGERPRINT.
DEPLOY_KNOWN_HOSTS=
# The daily status check's own key (docs/PRODUCTION_OPERATIONS.md, Alerting): the one
# line of status_key.pub here, as a REPOSITORY variable so that the install (production
# environment) and the daily check (production-status environment) both read it; its
# private key only in the production-status environment secret STATUS_SSH_KEY. The word
# remove makes the next install delete the status key's line from the server.
# If DEPLOY_HOST, DEPLOY_USER and DEPLOY_KNOWN_HOSTS are production environment settings,
# add the same three to the production-status environment as well.
STATUS_SSH_PUBLIC_KEY=
# The corresponding PRIVATE deployment key belongs in the DEPLOY_SSH_KEY secret.
# Set DEPLOY_DOCKER_CONTEXT instead of DEPLOY_DOCKER_HOST only when choosing a context.
