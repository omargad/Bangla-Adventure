# Non-secret GitHub Actions variables for Faysal's VPS, supplied 2026-11-05.
# This is a settings template, not an instruction to enable deployment.
# DEPLOY_ENABLED and DEPLOY_HOST must be repository-level variables.
DEPLOY_ENABLED=false
DEPLOY_HOST=203.0.113.10
DEPLOY_USER=deployer
DEPLOY_PORT=22
DEPLOY_PATH=/opt/bangla-adventures
DEPLOY_DOCKER_HOST=unix:///run/user/1002/docker.sock
# Fixed true in the GitHub workflow; these values also apply to manual scripts.
DEPLOY_REQUIRE_ROOTLESS=true
DEPLOY_REQUIRE_PUBLIC_HEALTH=true
DEPLOY_HOST_FINGERPRINT=SHA256:79xe+ubCodL2ACAHPNloo7I/K6mvngU88vEiFoEeWL8
DEPLOY_KEY_FINGERPRINT=SHA256:y1+C6cvcfpJFmO8pfjyMSFERpd5BtcQyDf5SptZXVlQ
# Add only the verified server public-key line matching DEPLOY_HOST_FINGERPRINT.
DEPLOY_KNOWN_HOSTS=
# The corresponding PRIVATE deployment key belongs in the DEPLOY_SSH_KEY secret.
# Set DEPLOY_DOCKER_CONTEXT instead of DEPLOY_DOCKER_HOST only when choosing a context.
