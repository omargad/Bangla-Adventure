# bangla-production-operations-v1
[Unit]
Description=Daily Bangla Adventures production backup, 16:30 UTC

[Timer]
# 03:30 in Melbourne during daylight saving (02:30 otherwise) and 22:30 in Dhaka.
OnCalendar=*-*-* 16:30:00 UTC
Persistent=true
Unit=ba-production-backup.service

[Install]
WantedBy=timers.target
