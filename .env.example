# Local development defaults. Keep this example free of real credentials/data.
# For production, set PUBLIC_ORIGIN and absolute persistent DATABASE_PATH and
# MEDIA_ROOT values. See docs/DEPLOYMENT.md before starting a production server.

# SQLite database file. The directory and schema are created automatically.
# Production example: /var/lib/bangla-adventures/bangla-adventures.db
DATABASE_PATH=.data/bangla-adventures.db

# Optional absolute directory for uploaded pronunciation audio.
# When unset, the application uses .data/media inside the project.
# MEDIA_ROOT=/absolute/path/to/media

# Port for `npm start`.
PORT=3000
# Optional loopback host port for compose.yaml (container port remains 3000).
# APP_PORT=3000

# Keep legacy for the current custom application.
# Select moodle only when intentionally switching to the separate Moodle pilot.
PLATFORM_MODE=legacy

# Required for production: the public HTTPS origin behind the reverse proxy.
# Leave it unset for local development.
# PUBLIC_ORIGIN=https://learning.example.org

# Optional build directory; use the same value when building and starting.
# NEXT_DIST_DIR=.next

# Optional alternative pilot only; leave blank for the current custom app.
# Moodle's public course URL. Production must use HTTPS. NEXT_PUBLIC_MOODLE_URL
# is also used by the browser UI; keep both values identical.
MOODLE_URL=
NEXT_PUBLIC_MOODLE_URL=
