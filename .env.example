# All values are optional; defaults shown.

# SQLite database file. The directory is created automatically.
DATABASE_PATH=.data/bangla-adventures.db

# Optional absolute directory for uploaded pronunciation audio.
# When unset, the application uses .data/media inside the project.
# MEDIA_ROOT=/absolute/path/to/media

# Port for `npm start`.
PORT=3000

# Keep legacy for the current custom application.
# Select moodle only when intentionally switching to the separate Moodle pilot.
PLATFORM_MODE=legacy

# Set this to the public HTTPS address when deploying behind a reverse proxy.
# Leave it unset for local development.
# PUBLIC_ORIGIN=https://learning.example.org

# Optional build directory; use the same value when building and starting.
# NEXT_DIST_DIR=.next

# Moodle's public course URL. Production must use HTTPS. NEXT_PUBLIC_MOODLE_URL
# is also used by the browser UI; keep both values identical.
MOODLE_URL=
NEXT_PUBLIC_MOODLE_URL=
