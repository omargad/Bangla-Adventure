# Copy to /etc/bangla-adventures/app.env, owned by root with mode 0600.
# Replace the example origin before enabling the service. No credentials here.
NODE_ENV=production
PLATFORM_MODE=legacy
PUBLIC_ORIGIN=https://learning.example.org
DATABASE_PATH=/var/lib/bangla-adventures/bangla-adventures.db
MEDIA_ROOT=/var/lib/bangla-adventures/media
NEXT_DIST_DIR=.next
NEXT_TELEMETRY_DISABLED=1
